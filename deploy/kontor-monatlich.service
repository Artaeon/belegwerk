[Unit]
Description=kontor: wiederkehrende Rechnungen des Monats ausstellen
# Pfade anpassen: /srv/kontor/kontor = Werkzeug, /srv/kontor/stoicera = Mandant

[Service]
Type=oneshot
WorkingDirectory=/srv/kontor/stoicera
ExecStart=/bin/sh -c 'bun /srv/kontor/kontor/src/kontor.mjs wiederkehrend && \
  git add -A && \
  (git diff --cached --quiet || git commit -m "Monatsrechnungen $(date +%%Y-%%m)") && \
  git push'
